# Copiar a .env y completar con valores reales.
#
#   cp .env.example .env
#
# Cómo cargarlo antes de correr la app en terminal, ver README.md.

# --- JWT (obligatorio, sin default en application.yml) ---
# Generar con: openssl rand -base64 48
JWT_SECRET=changeme-generate-with-openssl-rand-base64-48

# Vida del token en milisegundos. Opcional, default 86400000 (24h).
JWT_EXPIRATION_MS=86400000

# --- Postgres (debe calzar con docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kimngeam
DB_USER=kimngeam
DB_PASSWORD=kimngeam

# --- App (opcionales, tienen default en application.yml) ---
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# --- Corpus ---
# Ruta absoluta a la carpeta con las fuentes del corpus (diccionario, PDFs
# OCR, transcripciones .txt, JSONL preprocesado). Pesa ~240 MB y vive FUERA
# de este repo, por eso es una ruta configurable y nunca relativa. Opcional
# mientras la ingesta esté desactivada.
KIMNGEAM_CORPUS_PATH=/ruta/absoluta/a/fuentes-corpus

# Job de carga del corpus a corpus_chunk. Desactivado por defecto: nunca debe
# correr solo por levantar la app. Ver docs/TODO.md, Fase 2.
KIMNGEAM_CORPUS_INGESTION_ENABLED=false
KIMNGEAM_CORPUS_INGESTION_BATCH_SIZE=200

# Cuántos chunks trae rag/retrieval por consulta. Opcional, default 5.
KIMNGEAM_CORPUS_RETRIEVAL_TOP_N=5

# --- Proveedor de embeddings (Fase 2) ---
# openrouter (API externa, producción) u ollama (local, desarrollo — no
# consume créditos). Default ollama para que un clon nuevo del repo levante
# sin credenciales. El identificador guardado en corpus_chunk.modelo_embedding
# incluye el proveedor (ej. "ollama:bge-m3" u "openrouter:baai/bge-m3"),
# porque el mismo modelo servido por proveedores distintos no da
# necesariamente el mismo vector.
KIMNGEAM_EMBEDDING_PROVIDER=ollama

# OpenRouter expone una API de embeddings compatible con OpenAI. La api-key
# NUNCA lleva default (ver CLAUDE.md) — obtenerla en openrouter.ai/keys.
KIMNGEAM_EMBEDDING_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Modelo elegido tras la prueba comparativa de Fase 2 (dimensión 1024, ver
# migración V4). Sin default: nunca se hardcodea el modelo.
KIMNGEAM_EMBEDDING_OPENROUTER_MODEL=baai/bge-m3
KIMNGEAM_EMBEDDING_OPENROUTER_TIMEOUT=30s
KIMNGEAM_EMBEDDING_OPENROUTER_MAX_RETRIES=3

# Ollama corre local, sin api-key. Requiere tener el modelo ya descargado
# (ej. "ollama pull bge-m3").
KIMNGEAM_EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434
KIMNGEAM_EMBEDDING_OLLAMA_MODEL=bge-m3

# --- Proveedor del LLM de generación (Fase 3) ---
# openrouter (API externa, producción) u ollama (local, SOLO testeo — nunca
# producción). Default openrouter — a diferencia del proveedor de embeddings,
# acá Ollama no sirve como fallback de desarrollo: un modelo de chat local
# chico produce mapudungun inutilizable, así que solo obligaría a descargar
# un modelo sin aportar nada útil.
KIMNGEAM_LLM_PROVIDER=openrouter

# OpenRouter expone una API de chat compatible con OpenAI. La api-key NUNCA
# lleva default (ver CLAUDE.md) — obtenerla en openrouter.ai/keys.
KIMNGEAM_LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Default: el modelo que más se acercó al material validado en la prueba
# comparativa de Fase 3. Alternativas: google/gemini-3.1-flash-lite (más
# rápido, ~3s) y openai/gpt-5.4-mini (declara incertidumbre explícitamente).
KIMNGEAM_LLM_OPENROUTER_MODEL=google/gemini-3.8-flash
# Alto a propósito: la prueba comparativa midió latencias de 3 a 90s según el
# modelo.
KIMNGEAM_LLM_OPENROUTER_TIMEOUT=90s
KIMNGEAM_LLM_OPENROUTER_MAX_RETRIES=2

# Ollama corre local, sin api-key. SOLO para testeo (ver CLAUDE.md). Requiere
# tener el modelo ya descargado (ej. "ollama pull llama3.2").
KIMNGEAM_LLM_OLLAMA_BASE_URL=http://localhost:11434
KIMNGEAM_LLM_OLLAMA_MODEL=
KIMNGEAM_LLM_OLLAMA_TIMEOUT=90s
KIMNGEAM_LLM_OLLAMA_MAX_RETRIES=1

# Reintentos si la respuesta del LLM no parsea como el JSON esperado por
# segmento (ver rag/generation/TranslationResponseParser). Opcional, default 2
# (3 intentos totales).
KIMNGEAM_LLM_PARSING_MAX_REINTENTOS=2

# --- Orquestación del traductor (Fase 3) ---
# Bajo este score de similitud coseno un chunk recuperado se descarta como
# referencia — meter contexto irrelevante confunde al modelo. Opcional,
# default 0.5 (punto de partida, conviene recalibrarlo empíricamente).
KIMNGEAM_TRADUCTOR_UMBRAL_SIMILITUD=0.5

# Sobre este largo (caracteres) se rechaza el request con 400 — protección
# contra abuso, cada traducción cuesta dinero. Opcional, default 5000.
KIMNGEAM_TRADUCTOR_MAXIMO_ENTRADA=5000

# Bajo este largo (caracteres) el texto se traduce completo en un solo
# segmento; sobre él se parte por oraciones. Opcional, default 200.
KIMNGEAM_TRADUCTOR_UMBRAL_SEGMENTACION=200

# Cuánto más pesa un chunk validado por un académico frente a uno sin revisar
# (peso 1) al calcular la confianza de un segmento. Opcional, default 1.5.
KIMNGEAM_TRADUCTOR_PESO_CHUNK_VALIDADO=1.5

# Calibración de confianza (Fase 5, item 8) — ver ConfianzaProperties para el
# porqué de cada valor. Techo medido empíricamente sobre el corpus real.
KIMNGEAM_TRADUCTOR_CONFIANZA_TECHO_SIMILITUD=0.72
KIMNGEAM_TRADUCTOR_CONFIANZA_PESO_MAXIMO=0.5
KIMNGEAM_TRADUCTOR_CONFIANZA_CHUNKS_COBERTURA=3

# Límite de solicitudes a POST /traductor/traducir por IP dentro de la
# ventana — cada llamada cuesta dinero y el endpoint acepta requests
# anónimas. Opcionales, default 10 solicitudes por minuto.
KIMNGEAM_TRADUCTOR_RATE_LIMIT_MAX_REQUESTS=10
KIMNGEAM_TRADUCTOR_RATE_LIMIT_VENTANA=1m

# --- Panel de administración (Fase 5) ---
# Umbral para derivar estado = "sin-actividad" en GET /admin/usuarios.
# Opcional, default 30 días.
KIMNGEAM_ADMIN_UMBRAL_SIN_ACTIVIDAD=30d
# Cuántas validaciones recientes trae GET /admin/usuarios/:id. Opcional,
# default 10.
KIMNGEAM_ADMIN_VALIDACIONES_RECIENTES_LIMITE=10
# Vigencia del token de POST /admin/usuarios/invitar. Opcional, default 7 días.
KIMNGEAM_ADMIN_INVITACIONES_EXPIRACION=7d
# Cuántas filas trae "ultimas_validaciones" en GET /admin/dashboard. El
# contrato no fija un número. Opcional, default 5.
KIMNGEAM_ADMIN_DASHBOARD_ULTIMAS_VALIDACIONES_LIMITE=5

# --- Envío de correo (Fase 5) ---
# log (default, NO envía nada de verdad, solo lo deja en el log — ver
# shared/mail/LoggingMailSender) o smtp.
KIMNGEAM_MAIL_PROVIDER=log
# Remitente que verá el destinatario. Opcional, default no-reply@kimngeam.cl.
KIMNGEAM_MAIL_REMITENTE=no-reply@kimngeam.cl
# Host/puerto/usuario/password SMTP — propiedades estándar de Spring Boot
# (spring.mail.*), no de Kimngeam: por eso sin prefijo KIMNGEAM_. Las habla
# tanto el servidor institucional de la UFRO como los servicios
# transaccionales (ahí la API key se usa como password SMTP), así que cambiar
# de proveedor de correo es solo configuración. Solo hacen falta si
# KIMNGEAM_MAIL_PROVIDER=smtp.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- CORS (Fase 6) ---
# Lista separada por comas de orígenes explícitos permitidos — nunca "*", la
# API maneja tokens JWT. Opcional, default http://localhost:5173 (puerto por
# defecto de Vite). Quien levante el frontend debe agregar acá el origen real
# donde corra (ej. http://localhost:5173,https://kimngeam-frontend.ufro.cl).
KIMNGEAM_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Limpieza de token_invalidado (Fase 6) ---
# Frecuencia del job que purga filas ya expiradas de la blacklist de logout.
# Opcional, default 1h. Formato de duración de Spring (ej. 30m, 2h, 1d).
KIMNGEAM_TOKEN_INVALIDADO_CLEANUP_INTERVALO=1h
